// See docs/data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TestType {
  FingerTapping
  ReactionTime
  TargetTapping
  FingerTracing
  PhoneStability
  GuidedMovement
}

enum TouchEventType {
  TouchDown
  TouchUp
  StimulusShown
  TargetShown
  TouchMove
}

enum SessionStatus {
  Completed
  Aborted
}

model User {
  id        String        @id @default(cuid())
  deviceId  String        @unique
  createdAt DateTime      @default(now())
  sessions  TestSession[]
  batches   TestBatch[]
}

// A named, dated set of tests taken back-to-back in one run — chosen by the
// user up front (see apps/mobile's batch picker screen). Kept distinct from
// TestSession (still one single test) so "batch" and "session" never mean
// the same thing. No status field: a batch is just however many sessions it
// has so far, nothing else to track.
model TestBatch {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  name         String?
  createdAt    DateTime         @default(now())
  sessions     TestSession[]
  explanations LLMExplanation[]

  @@index([userId])
}

model TestSession {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id])
  batchId          String
  batch            TestBatch      @relation(fields: [batchId], references: [id])
  testType         TestType
  startedAt        DateTime
  endedAt          DateTime
  clientAppVersion String
  deviceMetadata   Json
  status           SessionStatus
  testParams       Json?
  events           RawEvent[]
  sensorSession    SensorSession?
  mlResults        MLResult[]

  @@index([userId])
  @@index([batchId])
}

model RawEvent {
  id        String         @id @default(cuid())
  sessionId String
  session   TestSession    @relation(fields: [sessionId], references: [id])
  seq       Int
  eventType TouchEventType
  tMs       Int
  x         Float?
  y         Float?
  pointerId Int?

  @@unique([sessionId, seq])
  @@index([sessionId])
}

// One row per session for continuous accelerometer/gyroscope streams
// (phone stability, guided movement) — 50-100Hz sampling makes row-per-sample
// storage (RawEvent's model) impractical. See decisions/0003.
model SensorSession {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   TestSession @relation(fields: [sessionId], references: [id])
  samples   Json
}

// Structured, versioned output of the Phase 3 ML service (services/ml) —
// one row per (session, model version). Written by the NestJS API via
// Prisma; services/ml is a stateless HTTP service with no DB access. See
// decisions/0006 and data-model.md.
model MLResult {
  id             String           @id @default(cuid())
  sessionId      String
  session        TestSession      @relation(fields: [sessionId], references: [id])
  modelId        String
  modelVersion   String
  metrics        Json
  computedAt     DateTime         @default(now())
  baselineResults BaselineResult[]

  @@unique([sessionId, modelId, modelVersion])
  @@index([sessionId])
}

// Phase 5a: per-metric comparison of one session's MLResult against that
// same user's own history of past MLResults for the same test type — a
// simple z-score, not a trained model (see decisions/0006 for the "ML is
// replaceable" property this keeps). One row per (session, model version),
// same reproducibility idiom as MLResult. Population-norm comparison is
// deliberately out of scope here — see docs/roadmap.md Phase 5.
model BaselineResult {
  id                 String   @id @default(cuid())
  mlResultId         String
  mlResult           MLResult @relation(fields: [mlResultId], references: [id])
  modelId            String
  modelVersion       String
  baselineSampleSize Int
  metrics            Json
  computedAt         DateTime @default(now())

  @@unique([mlResultId, modelId, modelVersion])
  @@index([mlResultId])
}

// Plain-language explanation of a batch's MLResult metrics, from the Phase 4
// LLM service (services/llm-explain) — one row per (batch, model version),
// same reproducibility idiom as MLResult. One row per *batch*, not per
// session: the whole reason TestBatch exists is to make one AI call cover
// every session in it, since (unlike Phase 3's free statistics) an LLM call
// is the one step that actually costs compute. Written by the NestJS API;
// services/llm-explain is a stateless HTTP service with no DB access. See
// decisions/0007-llm-hosting-and-guardrail.md.
model LLMExplanation {
  id              String    @id @default(cuid())
  batchId         String
  batch           TestBatch @relation(fields: [batchId], references: [id])
  modelId         String
  modelVersion    String
  explanationText String
  generatedAt     DateTime  @default(now())

  @@unique([batchId, modelId, modelVersion])
  @@index([batchId])
}
