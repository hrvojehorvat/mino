// See docs/data-model.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TestType {
  FingerTapping
  ReactionTime
  TargetTapping
  FingerTracing
  PhoneStability
  GuidedMovement
}

enum TouchEventType {
  TouchDown
  TouchUp
  StimulusShown
  TargetShown
  TouchMove
}

enum SessionStatus {
  Completed
  Aborted
}

model User {
  id        String        @id @default(cuid())
  deviceId  String        @unique
  createdAt DateTime      @default(now())
  sessions  TestSession[]
}

model TestSession {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  testType         TestType
  startedAt        DateTime
  endedAt          DateTime
  clientAppVersion String
  deviceMetadata   Json
  status           SessionStatus
  testParams       Json?
  events           RawEvent[]
  sensorSession    SensorSession?
  mlResults        MLResult[]

  @@index([userId])
}

model RawEvent {
  id        String         @id @default(cuid())
  sessionId String
  session   TestSession    @relation(fields: [sessionId], references: [id])
  seq       Int
  eventType TouchEventType
  tMs       Int
  x         Float?
  y         Float?
  pointerId Int?

  @@unique([sessionId, seq])
  @@index([sessionId])
}

// One row per session for continuous accelerometer/gyroscope streams
// (phone stability, guided movement) — 50-100Hz sampling makes row-per-sample
// storage (RawEvent's model) impractical. See decisions/0003.
model SensorSession {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   TestSession @relation(fields: [sessionId], references: [id])
  samples   Json
}

// Structured, versioned output of the Phase 3 ML service (services/ml) —
// one row per (session, model version). Written directly by the Python
// service, not by the NestJS API. See decisions/0006 and data-model.md.
model MLResult {
  id           String      @id @default(cuid())
  sessionId    String
  session      TestSession @relation(fields: [sessionId], references: [id])
  modelId      String
  modelVersion String
  metrics      Json
  computedAt   DateTime    @default(now())

  @@unique([sessionId, modelId, modelVersion])
  @@index([sessionId])
}
