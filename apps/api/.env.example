DATABASE_URL=postgresql://mino:mino@localhost:5432/mino
PORT=3000
# Signs/verifies login tokens (JWT). Any long random string works for local
# dev; use a real secret (e.g. from Azure Container Apps' secret store) once
# deployed.
JWT_SECRET=dev-local-secret-change-me
ML_SERVICE_URL=http://localhost:5001
# Points at a real services/llm-explain deployment (Modal). For manual
# testing without spending GPU credits, run the local canned-response stub
# instead: `python3 -m mino_llm.dev_stub` from services/llm-explain/ — it
# listens on this same default port, so usually no change is needed here.
LLM_SERVICE_URL=http://localhost:5002
